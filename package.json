{
  "name": "ultrablabla",
  "version": "1.0.0",
  "private": true,
  "description": "Application d'assistant vocal UltraBlabla",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "build": "bun build src/fe/webapp.ts --outfile=public/webapp.js --target=browser --minify",
    "android:build": "bun run build && npx cap sync android && npx cap build android", 
    "android:run": "bun run build && npx cap sync android && npx cap run android",
    "android:open": "npx cap open android",
    "llama:install": "./install-llama.bat",
    "setup:complete": "npm run llama:install && npm run android:build"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@elysiajs/static": "^1.3.0",
    "elysia": "^1.3.21"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "typescript": "^5.0.0",
    "bun-types": "latest"
  }
}
