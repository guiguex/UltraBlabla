{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "rootDir": "./src/fe",
    "outDir": "./public",
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "include": ["src/fe/**/*"]
}
