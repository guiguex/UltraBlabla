{
  "name": "ultrablabla",
  "version": "1.0.0",
  "private": true,
  "description": "Application d'assistant vocal UltraBlabla",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "test": "bun test src/",
    "test:watch": "bun test --watch src/",
    "build": "bun build src/fe/webapp.ts --outfile=public/webapp.js --target=browser --minify",
    "android:sync": "bun run build && bun x cap sync android",
    "android:open": "bun x cap open android",
    "android:prepare": "powershell -ExecutionPolicy Bypass -File build-android.ps1",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "wails:build": "bun run build && powershell -Command \"New-Item -ItemType Directory -Force -Path src-wails\\frontend\\dist; Copy-Item -Path public\\* -Destination src-wails\\frontend\\dist -Recurse -Force\" && cd src-wails && wails3 build",
    "wails:dev": "cd src-wails && wails3 dev"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/core": "^8.5.0",
    "@elysiajs/static": "^1.4.10",
    "elysia": "^1.4.29"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "typescript": "^7.0.2",
    "bun-types": "^1.3.14"
  }
}